# Copy to .env, then generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=
BACKEND_PORT=6365
FRONTEND_PORT=6366
FLUX_VERSION=dev
# Optional: exact public frontend origin for passkeys, e.g. https://panel.example.com
FLVX_WEBAUTHN_ORIGIN=
DB_TYPE=sqlite
DATABASE_URL=
# Set these when enabling the postgres service.
POSTGRES_DB=flux_panel
POSTGRES_USER=flux_panel
POSTGRES_PASSWORD=
